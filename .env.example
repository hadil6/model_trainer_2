APP_NAME=Profiling Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
ARTIFACTS_DIR=artifacts
MAX_UPLOAD_MB=50
SAMPLE_SEED=42
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=120

# ── SMTP for login + pipeline-completion notifications ───────────────────────
# Leave empty to disable email sending (the app still works, just no emails).
# Gmail: enable 2FA → generate an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.notifications@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=AI Model Trainer
